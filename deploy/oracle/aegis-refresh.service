[Unit]
Description=AEGIS hourly Space-Track refresh and 18 SDS cross-check archive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=aegis
Group=aegis
EnvironmentFile=/etc/aegis/aegis.env
Environment=XDG_CACHE_HOME=/var/cache/aegis
Environment=XDG_STATE_HOME=/var/lib/aegis
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/aegis/app/aegis
# Skip cleanly (not a failure) until credentials are filled in. `$$` defers
# expansion to the shell so the password never lands on a command line.
ExecCondition=/bin/sh -c 'test -n "$${SPACETRACK_USER}" && test -n "$${SPACETRACK_PASS}"'
ExecStart=/opt/aegis/venv/bin/python -m aegis.ingest.spacetrack refresh
# Append each new public CDM with AEGIS's prediction made now, building a
# validation history at /var/lib/aegis/aegis/crosscheck/cdm_public.jsonl.
ExecStart=/opt/aegis/venv/bin/python -m aegis.pipeline.crosscheck --archive --rows 0
TimeoutStartSec=15min
Nice=10

CacheDirectory=aegis
CacheDirectoryMode=0750
StateDirectory=aegis
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
